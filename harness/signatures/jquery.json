{
  "product": "jQuery",
  "signatures": [
    {
      "id": "jquery-version-banner",
      "asset_kinds": ["js"],
      "match": {
        "type": "regex",
        "pattern": "jQuery(?:\\s+JavaScript\\s+Library)?\\s+v?(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)"
      },
      "implies": { "provenance": "confirmed" },
      "note": "jQuery 배너/버전 문자열 — 원본에 실재하므로 confirmed"
    },
    {
      "id": "jquery-fn-jquery",
      "asset_kinds": ["js"],
      "match": {
        "type": "regex",
        "pattern": "jquery\\s*[:=]\\s*[\"'](?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)[\"']"
      },
      "implies": { "provenance": "confirmed" },
      "note": "jQuery.fn.jquery 버전 프로퍼티"
    },
    {
      "id": "jquery-present",
      "asset_kinds": ["js"],
      "match": { "type": "regex", "pattern": "\\bjQuery\\b|\\$\\.fn\\.jquery" },
      "implies": { "provenance": "guess" },
      "note": "jQuery 존재는 확인되나 버전 불명 — 약한 단서"
    }
  ]
}
